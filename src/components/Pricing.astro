---
// Prices and inclusions live in src/data/packages.ts.
import { packages as tiers } from '../data/packages';
---

<section id="pricing">
  <div class="container">
    <h2>Three rivers, three packages</h2>
    <p class="section-intro">
      Straightforward pricing for residential listings. Commercial projects,
      construction progress, and multi-property packages are quoted individually, so
      <a href="#contact">get in touch</a> for a custom estimate.
    </p>
    <div class="tiers">
      {tiers.map((tier) => {
        const save = tier.salePrice
          ? Number(tier.price.replace(/\D/g, '')) - Number(tier.salePrice.replace(/\D/g, ''))
          : 0;
        return (
        <article class={`card tier ${tier.featured ? 'featured' : ''}`}>
          {tier.featured && <span class="badge">Most Popular</span>}
          <h3>{tier.name}</h3>
          <p class="tagline">{tier.tagline}</p>
          {tier.salePrice ? (
            <>
              <p class="sale-flag">
                Limited time<span class="dot">·</span>save ${save}
              </p>
              <p class="price">
                <span class="was">{tier.price}</span>
                <span class="now">{tier.salePrice}</span>
                <span class="unit"> / listing</span>
              </p>
            </>
          ) : (
            <p class="price">{tier.price}<span class="unit"> / listing</span></p>
          )}
          <ul>
            {tier.features.map((feature) => <li>{feature}</li>)}
          </ul>
          <a href="#contact" class={`btn ${tier.featured ? 'btn-gold' : 'btn-outline'}`} data-package={tier.name}>Book This Package</a>
        </article>
        );
      })}
    </div>
  </div>
</section>

<script>
  // "Book This Package" jumps to the contact form (via its href) and
  // pre-selects the chosen package, flashing the field so the change is seen.
  const select = document.querySelector<HTMLSelectElement>('#contact-form select[name="package"]');
  document.querySelectorAll<HTMLAnchorElement>('a[data-package]').forEach((link) => {
    link.addEventListener('click', () => {
      if (!select || !link.dataset.package) return;
      select.value = link.dataset.package;
      select.classList.remove('prefilled');
      void select.offsetWidth; // restart the flash if it's already running
      select.classList.add('prefilled');
    });
  });
</script>

<style>
  .tiers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 1.5rem;
    margin-top: 3rem;
    align-items: start;
  }

  .tier {
    position: relative;
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
  }

  .tier.featured {
    border-color: var(--gold-500);
    background: linear-gradient(180deg, rgba(212, 175, 55, 0.08), var(--ink-700) 40%);
  }

  .badge {
    position: absolute;
    top: -0.8rem;
    left: 50%;
    transform: translateX(-50%);
    background: var(--gold-500);
    color: var(--ink-900);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.3rem 1rem;
    border-radius: 2px;
    white-space: nowrap;
  }

  .tagline {
    font-size: 0.9rem;
    color: var(--stone-dim);
    margin-bottom: 1.5rem;
  }

  .price {
    font-family: var(--font-display);
    font-size: 3rem;
    color: var(--cream);
    margin-bottom: 1.5rem;
    line-height: 1;
  }

  .price .unit {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--stone-dim);
  }

  .price .was {
    font-size: 1.5rem;
    color: var(--stone-dim);
    text-decoration: line-through;
    margin-right: 0.5rem;
  }

  .price .now {
    color: var(--gold-500);
  }

  .sale-flag {
    display: flex;
    align-items: center;
    margin-bottom: 0.5rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-500);
  }

  .sale-flag .dot {
    margin-inline: 0.5rem;
    opacity: 0.6;
  }

  .tier ul {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: grid;
    gap: 0.7rem;
    flex-grow: 1;
  }

  .tier li {
    position: relative;
    padding-left: 1.5rem;
    font-size: 0.9375rem;
  }

  .tier li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--gold-500);
    font-weight: 700;
  }

  .tier .btn { justify-content: center; }
</style>
