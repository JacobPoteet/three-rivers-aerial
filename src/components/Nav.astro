---
import Logo from './Logo.astro';

const links = [
  { href: '#services', label: 'Services' },
  { href: '#portfolio', label: 'Portfolio' },
  { href: '#pricing', label: 'Pricing' },
  { href: '#about', label: 'About' },
];
---

<header class="nav-wrap">
  <div class="container nav">
    <a href="#top" class="brand" aria-label="Three Rivers Aerial Co., home">
      <Logo draw />
    </a>
    <nav class="desktop-nav" aria-label="Primary">
      <ul>
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
    <a href="#contact" class="btn btn-gold nav-cta">Book a Flight</a>
    <button
      class="nav-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
  <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile" hidden>
    <ul>
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
      <li><a href="#contact" class="btn btn-gold">Book a Flight</a></li>
    </ul>
  </nav>
</header>

<script>
  const wrap = document.querySelector('.nav-wrap');
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.getElementById('mobile-menu');

  if (wrap && toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.hidden = !open;
      wrap.classList.toggle('open', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Close after tapping a link, and on Escape.
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => setOpen(false))
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }

  // Let the hero video show through the bar until the visitor scrolls past
  // the hero. Without JS the bar simply stays solid.
  const hero = document.getElementById('top');
  if (wrap && hero) {
    new IntersectionObserver(
      ([entry]) => wrap.classList.toggle('over-hero', entry.isIntersecting),
      { rootMargin: '-80px 0px 0px 0px' }
    ).observe(hero);
  }

  // Highlight the link for the section currently in the middle of the screen.
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.desktop-nav a');
  const sections = [...navLinks]
    .map((a) => document.querySelector<HTMLElement>(a.hash))
    .filter((el): el is HTMLElement => el !== null);
  const visible = new Set<string>();
  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) =>
        entry.isIntersecting ? visible.add(entry.target.id) : visible.delete(entry.target.id)
      );
      navLinks.forEach((a) => {
        if (visible.has(a.hash.slice(1))) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
    },
    { rootMargin: '-45% 0px -50% 0px' }
  );
  sections.forEach((section) => sectionObserver.observe(section));
</script>

<style>
  .nav-wrap {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid rgba(212, 175, 55, 0.14);
    transition: border-color 0.4s ease;
  }

  /* The solid bar lives on a pseudo-element so it can fade in and out;
     a background-color transition can't fade a backdrop blur. */
  .nav-wrap::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(10, 10, 12, 0.82);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    transition: opacity 0.4s ease;
  }

  /* Over the hero: no bar, just a soft shade so the links stay legible. */
  .nav-wrap.over-hero:not(.open) {
    border-bottom-color: transparent;
    background: linear-gradient(to bottom, rgba(10, 10, 12, 0.55), transparent);
  }

  .nav-wrap.over-hero:not(.open)::before { opacity: 0; }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 0.85rem;
  }

  .desktop-nav ul {
    display: flex;
    gap: 2.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .desktop-nav a {
    position: relative;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--stone);
  }

  .desktop-nav a:hover { color: var(--gold-400); }

  .desktop-nav a[aria-current] { color: var(--cream); }

  /* Gold rule that draws in under the current section's link. */
  .desktop-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0.1em; /* offset the trailing letter-spacing */
    bottom: -0.35rem;
    height: 1px;
    background: var(--gold-500);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s ease;
  }

  .desktop-nav a[aria-current]::after { transform: scaleX(1); }

  .nav-cta {
    padding: 0.6rem 1.4rem;
    font-size: 0.8125rem;
  }

  /* Hamburger button — hidden on desktop */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .nav-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    margin-inline: auto;
    background: var(--cream);
    transition: transform 0.25s ease, opacity 0.2s ease;
  }

  .nav-wrap.open .nav-toggle span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-wrap.open .nav-toggle span:nth-child(2) { opacity: 0; }
  .nav-wrap.open .nav-toggle span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile dropdown panel */
  .mobile-menu {
    border-top: 1px solid rgba(212, 175, 55, 0.14);
    background: rgba(10, 10, 12, 0.98);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      display 0.25s allow-discrete;
  }

  /* Slide down on open, back up on close. @starting-style supplies the
     "before" state when the panel goes from display:none to visible. */
  .mobile-menu[hidden] {
    display: none;
    opacity: 0;
    transform: translateY(-0.75rem);
  }

  @starting-style {
    .mobile-menu:not([hidden]) {
      opacity: 0;
      transform: translateY(-0.75rem);
    }
  }

  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 1rem clamp(1.25rem, 4vw, 2.5rem) 1.75rem;
    display: grid;
    gap: 0.25rem;
  }

  .mobile-menu a:not(.btn) {
    display: block;
    padding: 0.85rem 0;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--stone);
    border-bottom: 1px solid var(--ink-600);
  }

  .mobile-menu a:not(.btn):hover { color: var(--gold-400); }

  .mobile-menu .btn {
    margin-top: 1rem;
    justify-content: center;
  }

  @media (max-width: 820px) {
    .desktop-nav,
    .nav-cta { display: none; }
    .nav-toggle { display: flex; }
  }
</style>
